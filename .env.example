# Supabase: configure uma das chaves públicas abaixo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos Supabase antigos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canais públicos de atendimento.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Apenas servidor: nunca prefixar com NEXT_PUBLIC_ nem compartilhar.
SUPABASE_SERVICE_ROLE_KEY=
# Turnstile: chave pública no navegador e secreta no servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Segredo de alta entropia (>= 32 bytes) para reserva de estoque.
RESERVATION_HASH_SECRET=