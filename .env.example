NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave privada do Supabase: somente no servidor (nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile: chave pública no navegador e segredo no servidor
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Gere um segredo aleatório independente das chaves do Supabase (>= 32 bytes)
RESERVATION_HASH_SECRET=
# Somente números, com DDI e DDD. Exemplo de formato: 5551999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Canal oficial para solicitações de privacidade e dados pessoais
NEXT_PUBLIC_PRIVACY_EMAIL=
